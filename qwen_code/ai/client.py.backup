                if self.is_oauth_token:
                    headers["X-DashScope-AuthType"] = "OAuth2"
                
                # For Qwen OAuth tokens, we need to indicate the auth type to DashScope
                if self.is_oauth_token:
                    headers["X-DashScope-AuthType"] = "OAuth2"
                
